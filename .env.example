# ================== J.A.R.V.I.S. LOCAL – Einstellungen ==================
# Die meisten Werte stellst du bequem im Jarvis-Fenster unter EINSTELLUNGEN ein.
# Nach Änderungen hier: Tray-Icon → „Neu starten“.

# --- KI-Anbieter: xkiro, huggingface, claude, ollama oder auto ---
# auto: xKiro → Hugging Face → Claude → Ollama
JARVIS_PROVIDER=auto
# 0 = harte Cloud-Sperre: Jarvis nutzt ausschließlich Ollama.
JARVIS_CLOUD_ENABLED=1

# --- xKiro: ein Gateway für viele aktuelle Modelle ---
XKIRO_API_KEY=
XKIRO_MODEL=openai/gpt-5.6-sol
XKIRO_REASONING_EFFORT=
XKIRO_NUM_CTX=200000
XKIRO_MAX_TOKENS=4096
XKIRO_TIMEOUT_SEC=105

# --- Hugging Face Inference Providers ---
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b
HF_VISION_MODEL=
# fastest, cheapest oder preferred
HF_POLICY=cheapest
HF_NUM_CTX=128000
HF_MAX_TOKENS=4096
HF_TIMEOUT_SEC=120

# --- Multi-Agenten-Rat (benötigt xKiro) ---
# auto = nur bei komplexen Aufgaben; always = bei jeder Anfrage; off = aus
JARVIS_AGENTS_ENABLED=1
JARVIS_AGENT_MODE=auto
# Maximal ausgewählte Spezialisten / gleichzeitig laufende Anfragen
JARVIS_AGENT_MAX_AGENTS=5
JARVIS_AGENT_MAX_PARALLEL=4
# Antwortbudget pro Spezialist und Modell-Fallbacks bei nicht verfügbarem Modell
JARVIS_AGENT_MAX_TOKENS=1200
JARVIS_AGENT_MODEL_FALLBACKS=2
# Autonome Missionen: Rat im ersten Zyklus und danach alle N Zyklen erneut.
JARVIS_AGENT_MISSION_EVERY=4
# 1 = kostenlose Modelle im Live-Katalog bevorzugen
JARVIS_AGENT_PREFER_FREE=1
# Premium ist standardmäßig aus, damit ein Agentenrat nicht überraschend teure Modelle startet.
JARVIS_AGENT_ALLOW_PREMIUM=0
# Modellquellen für Spezialisten
JARVIS_AGENT_USE_XKIRO=1
JARVIS_AGENT_USE_HF=1
JARVIS_AGENT_USE_OLLAMA=1

# --- Agent Factory / Upgrade-System ---
# Baut Prompt-/Routing-Child-Agenten, keine neuen Foundation-Model-Gewichte.
JARVIS_UPGRADE_AUTO=1
# Auto-Läufe nur mit lokalen oder als free markierten Modellen; manueller /upgrade darf den erlaubten Pool nutzen.
JARVIS_UPGRADE_FREE_ONLY=1
JARVIS_UPGRADE_INTERVAL_HOURS=24
JARVIS_UPGRADE_MAX_CHILDREN=12
JARVIS_UPGRADE_BENCH_TASKS=2

# --- Claude direkt über Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_NUM_CTX=100000
CLAUDE_TIMEOUT_SEC=180
# Budget nach Kostenschätzung, 0 deaktiviert das Limit. Preise in USD pro 1 Mio. Tokens.
# Bei Modellwechsel aktuelle Anthropic-Preise hier anpassen.
CLAUDE_DAILY_BUDGET_USD=1
CLAUDE_PRICE_IN=2
CLAUDE_PRICE_OUT=10

# --- Lokale KI (Ollama) ---
JARVIS_MODEL=qwen3:8b
JARVIS_VISION_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_THINK=0
JARVIS_TEMPERATURE=0.2
# Diese Werte setzt der Installer passend zu deinem Arbeitsspeicher:
JARVIS_NUM_CTX=16384
JARVIS_MAX_TOKENS=4096
JARVIS_KEEP_ALIVE=30m
HISTORY_TURNS=16
JARVIS_TOOL_RESULT_MAX=12000

# --- Wer bist du? ---
OWNER_NAME=Marvin
OWNER_TITLE=Sir
OWNER_INFO=
TZ=Europe/Berlin

# --- Zugriff: 1 = ganzer PC (mit deinen Benutzerrechten), 0 = nur Workspace ---
JARVIS_FULL_ACCESS=1

# --- Telegram (Token von @BotFather). Die ID trägt Jarvis beim Koppeln selbst ein. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Lokale Spracheingabe (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Online-Server (n8n) – optional ---
N8N_BASE_URL=
N8N_SECRET=

# --- Optionale Integrationen ---
# E-Mail, z.B. STRATO: smtp.strato.de / Port 465 / imap.strato.de
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
STRIPE_SECRET_KEY=
# Weitere API-Keys für Jarvis: SECRET_<NAME>=wert  (z.B. SECRET_XKIRO=...)
